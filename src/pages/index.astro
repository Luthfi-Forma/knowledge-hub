---
import BaseLayout from '../layouts/BaseLayout.astro';
import SheetIndex from '../components/index/SheetIndex.astro';
import { getPublishedPosts } from '../lib/posts';
import { topicCounts } from '../lib/topics';

const posts = await getPublishedPosts();
const topicCount = topicCounts(posts).size;
const breadcrumbLeft = `Sheet index · ${posts.length} plates · ${topicCount} topics · no filter`;
---

<BaseLayout title="Afreza Hernanda — knowledge-hub" breadcrumbLeft={breadcrumbLeft}>
  <SheetIndex posts={posts} />
</BaseLayout>
