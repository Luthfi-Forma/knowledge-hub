---
// Post detail — Atlas rail marginalia (M6/T-57). Spec: docs/design/atlas/
// README.md "Screens > 03 · /posts/[slug]"; layout reference
// docs/design/atlas/Hi-Fi - Atlas Screens.dc.html screen 03 (a
// scrollytelling post, Cikarang).
//
// Rail order, top to bottom: Sections (TableOfContents, non-scrollytelling
// only — scrollytelling's own sections live inside the React island,
// out of scope here) → Stamp lembar (coordinates/date/plate number/impact
// slot) → Project (repo/demo promoted to real controls, up from a 14px
// meta-text row) → Topics → Related plates (deliberately NOT Plate.astro
// — "bergaya berbeda dari index... supaya terbaca sebagai rekomendasi",
// so these read as recommendations, not more index entries).
//
// Marginalia cross-links (Hi-Fi's "tautan silang" block) are NOT rendered
// anywhere on this page: zero posts have inline cross-links in their MDX
// body today (M7 editorial gap, ADR-004 Consequences) and there's no
// schema field to detect "this post has some" — an empty slot with no
// data would be a placeholder, which M6's own rule forbids. The block
// returns when M7 supplies real inline links and a way to surface them.
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getPublishedPosts, getProjectTitle, getRelatedPosts, TYPE_LABEL } from '../../lib/posts';
import CikarangIndustrialSettlementScrollytelling from '../../lib/scrollytelling/cikarang-industrial-settlement-pattern';
import BontangPovertyMappingScrollytelling from '../../lib/scrollytelling/bontang-poverty-mapping';
import JabungLampungCoastalDevelopmentScrollytelling from '../../lib/scrollytelling/jabung-lampung-coastal-development';
import RpplhSouthPapuaScrollytelling from '../../lib/scrollytelling/rpplh-south-papua';

// ADR-002: each scrollytelling post is a bespoke wired-up React island (data
// + viz + shell). Astro's `client:*` hydration needs a statically-analyzable
// import reference in the template — not a variable assigned at runtime from
// a lookup map — so a new scrollytelling post gets its own explicit branch
// here rather than a generic slug → component registry. To add one:
//   1. Static-import the post's wired-up island component below (see
//      CikarangIndustrialSettlementScrollytelling).
//   2. Add a branch next to the existing one, further down this file:
//      {isScrollytelling && post.id === '<slug>' && <Component client:visible />}

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, summary, date, type, tags, project, repo, demo, cover, coordinates, impact } = post.data;
const { Content, headings } = await render(post);

const allPosts = await getPublishedPosts();
const plateNumbers = new Map(allPosts.map((p, i) => [p.id, i + 1]));
const plateNumber = plateNumbers.get(post.id)!;
const plateNumberLabel = String(plateNumber).padStart(2, '0');

const relatedPosts = await getRelatedPosts(post);

const formattedDate = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const formattedDateShort = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const sections = headings.filter((heading) => heading.depth === 2);
const isArticle = type === 'article';
const isScrollytelling = post.data.presentation === 'scrollytelling';

const breadcrumbLeft = `Index / ${TYPE_LABEL[type]} / Plate ${plateNumberLabel}`;
const breadcrumbRight = coordinates ? `${coordinates} · ${formattedDateShort}` : formattedDateShort;
---

<BaseLayout
  title={`${title} — Afreza Hernanda`}
  description={summary}
  image={`/og/${post.id}.png`}
  breadcrumbLeft={breadcrumbLeft}
  breadcrumbRight={breadcrumbRight}
>
  <article class="post-detail">
    <header class="post-header">
      <p class="post-notation">
        <span class:list={['post-swatch', `hatch-${type}`]} aria-hidden="true" />
        <span>{TYPE_LABEL[type]}</span>
        {isScrollytelling && <span class="flag">Interactive</span>}
      </p>
      {!isScrollytelling && <h1 class="post-title">{title}</h1>}
      {!isScrollytelling && <p class="post-dek">{summary}</p>}
    </header>

    <div class:list={['post-body', isScrollytelling && 'post-body-wide']}>
      <div class="post-main">
        {
          /* The `view-transition-name` here is the other half of the pair set
             on Plate.astro's thumbnail (M10/T-73) — same `plate-{id}` value,
             so navigating from any index into this post morphs the cover
             across documents. Only this post carries the name in this
             document, so exactly one element matches. */
          !isScrollytelling && cover &&
            (type === 'photo' ? (
              <Image
                src={cover}
                alt={title}
                class="mb-8 max-h-[75vh] w-full object-contain"
                style={`view-transition-name: plate-${post.id}`}
                widths={[600, 1200]}
                sizes="800px"
              />
            ) : (
              <Image
                src={cover}
                alt=""
                class="mb-8 aspect-video w-full object-cover"
                style={`view-transition-name: plate-${post.id}`}
                widths={[600, 1200]}
                sizes="800px"
              />
            ))
        }

        {!isScrollytelling && sections.length > 0 && <TableOfContents sections={sections} />}

        {
          !isScrollytelling && (
            <div class:list={['prose-content max-w-none text-[0.9375rem] leading-relaxed text-ink', isArticle && 'prose-article']}>
              <Content />
            </div>
          )
        }

        {isScrollytelling && post.id === 'cikarang-industrial-settlement-pattern' && <CikarangIndustrialSettlementScrollytelling client:visible />}
        {isScrollytelling && post.id === 'bontang-poverty-mapping' && <BontangPovertyMappingScrollytelling client:visible />}
        {isScrollytelling && post.id === 'jabung-lampung-coastal-development' && <JabungLampungCoastalDevelopmentScrollytelling client:visible />}
        {isScrollytelling && post.id === 'rpplh-south-papua' && <RpplhSouthPapuaScrollytelling client:visible />}
      </div>

      <aside class="post-rail">
        {!isScrollytelling && sections.length > 0 && <TableOfContents sections={sections} />}

        <div class="rail-block rail-stamp">
          <p class="rail-heading">Stamp lembar</p>
          <div class="rail-stamp-body">
            {coordinates && <span>{coordinates}</span>}
            <span>{formattedDate}</span>
            <span>
              {TYPE_LABEL[type]} · Plate {plateNumberLabel}
            </span>
            {impact && impact.map((fact) => <span>{fact.label}: {fact.value}</span>)}
          </div>
        </div>

        {
          (project || repo || demo) && (
            <div class="rail-block">
              <p class="rail-heading">Project</p>
              <div class="rail-project-controls">
                {repo && (
                  <a href={repo} target="_blank" rel="noopener" class="control control-primary">
                    Repository ↗
                  </a>
                )}
                {demo && (
                  <a href={demo} target="_blank" rel="noopener" class="control control-secondary">
                    Live demo ↗
                  </a>
                )}
                {project && (
                  <a href={`/projects/${project}`} class="control control-tertiary">
                    {getProjectTitle(project)}
                  </a>
                )}
              </div>
            </div>
          )
        }

        {
          tags.length > 0 && (
            <div class="rail-block">
              <p class="rail-heading">Topics</p>
              <div class="rail-topics">
                {tags.map((tag) => (
                  <a href={`/topics/${tag}`} class="rail-topic-chip">
                    {tag}
                  </a>
                ))}
              </div>
            </div>
          )
        }

        {
          relatedPosts.length > 0 && (
            <div class="rail-block">
              <p class="rail-heading">Related plates</p>
              <div class="related-plates">
                {relatedPosts.map(({ post: related, sharedTagCount }) => (
                  <a href={`/posts/${related.id}`} class="related-plate">
                    <p class="related-plate-notation">
                      {TYPE_LABEL[related.data.type]} · +{sharedTagCount} shared {sharedTagCount === 1 ? 'tag' : 'tags'}
                    </p>
                    <p class="related-plate-title">{related.data.title}</p>
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .post-detail {
    max-width: var(--container-shell);
    margin-inline: auto;
    padding: 40px 20px 48px;
  }
  @media (min-width: 640px) {
    .post-detail {
      padding: 40px 48px 48px;
    }
  }

  .post-header {
    max-width: 1000px;
    margin-bottom: 32px;
  }

  .post-notation {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .post-swatch {
    display: inline-block;
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    border: 1px solid var(--color-ink);
  }

  .post-title {
    margin: 0 0 16px;
    font-family: var(--font-display);
    font-stretch: 120%;
    font-weight: 800;
    font-size: 40px;
    line-height: 1.04;
    max-width: 28ch;
    color: var(--color-ink);
  }
  @media (min-width: 640px) {
    .post-title {
      font-size: 48px;
    }
  }

  .post-dek {
    margin: 0;
    max-width: 60ch;
    font-size: 17px;
    line-height: 1.55;
    color: var(--color-ink-muted);
  }
  @media (min-width: 640px) {
    .post-dek {
      font-size: 19px;
    }
  }

  .post-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  /* Scrollytelling posts (.post-body-wide) skip this split — T-67. The
     island already owns a 5/7 internal grid (Scrollytelling.tsx) sized
     for the full --container-shell width; splitting .post-main down to
     --container-prose (680px) on top of that squeezed its columns to
     ~316px each (~38ch/line, measured) and left the rail (416px) wider
     than the island's own text column. Non-scrollytelling posts are
     unaffected — they still want the 680px prose measure. */
  @media (min-width: 1024px) {
    .post-body:not(.post-body-wide) {
      grid-template-columns: var(--container-prose) 1fr;
      gap: 48px;
      align-items: start;
    }
  }

  /* TableOfContents renders twice in the markup (once above .post-main's
     content on narrow screens where the rail column collapses below the
     prose, once in .post-rail for the ≥1024px 2-column layout) — CSS
     toggles which copy is visible rather than duplicating the section
     data fetch differently per breakpoint. `:global(nav)` is required:
     the <nav> is TableOfContents' own root element, carrying ITS
     component's scope hash, not this page's — an unmarked `> nav` here
     compiles to a selector scoped to a hash that element never carries,
     so it silently never matches (found by testing: both copies stayed
     visible at once, rather than the intended none/block).
   */
  .post-main > :global(nav) {
    display: block;
    margin-bottom: 24px;
  }
  .post-rail > :global(nav) {
    display: none;
  }
  @media (min-width: 1024px) {
    .post-main > :global(nav) {
      display: none;
    }
    .post-rail > :global(nav) {
      display: block;
    }
  }

  .post-rail {
    border-left: none;
    padding-left: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  @media (min-width: 1024px) {
    .post-rail {
      border-left: 1px solid var(--color-line);
      padding-left: 24px;
    }
  }

  /* Scrollytelling posts: the rail sits BELOW the island, full width, not
     beside it (T-67) — the island already has its own 2-column narrative
     (text + sticky viz); a third column squeezed alongside it is the
     actual design mistake, not just a width shortage (measured: the rail
     at 416px was wider than the island's own former text column at
     316px). A horizontal divider replaces the vertical one, and the rail
     blocks lay out side by side across the full width instead of
     stacking, matching the layout's real proportions. */
  .post-body-wide .post-rail {
    border-left: none;
    padding-left: 0;
  }
  @media (min-width: 1024px) {
    .post-body-wide .post-rail {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--color-line);
      padding-top: 24px;
      margin-top: 8px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 24px;
    }
  }

  .rail-heading {
    margin: 0 0 10px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .rail-stamp {
    border: 1px solid var(--color-ink);
    background-color: var(--color-paper-raised);
    padding: 16px;
  }
  .rail-stamp-body {
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-ink);
  }

  .rail-project-controls {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }

  .rail-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .rail-topic-chip {
    display: inline-flex;
    white-space: nowrap;
    text-decoration: none;
    color: var(--color-ink);
    font-size: 12.5px;
    padding: 3px 7px;
    border: 1px solid var(--color-line-strong);
    background-color: var(--color-paper);
  }
  .rail-topic-chip:hover,
  .rail-topic-chip:focus-visible {
    border-color: var(--color-research);
    color: var(--color-research);
  }
  .rail-topic-chip:focus-visible {
    outline: 2px solid var(--color-research);
    outline-offset: 2px;
  }

  .related-plates {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .related-plate {
    display: block;
    border: 1px solid var(--color-line-strong);
    background-color: var(--color-paper-raised);
    padding: 10px;
    text-decoration: none;
    transition: border-color 120ms ease;
  }
  .related-plate:hover,
  .related-plate:focus-visible {
    border-color: var(--color-research);
  }
  .related-plate:focus-visible {
    outline: 2px solid var(--color-research);
    outline-offset: 2px;
  }
  .related-plate-notation {
    margin: 0 0 3px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .related-plate-title {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 108%;
    font-weight: 600;
    font-size: 14.5px;
    line-height: 1.25;
    color: var(--color-ink);
  }

  .prose-content {
    font-family: var(--font-display);
  }
  .prose-content :global(p) {
    margin-bottom: 1.25em;
  }
  .prose-content :global(h2) {
    margin-top: 2em;
    margin-bottom: 0.75em;
    font-size: 1.375rem;
    font-weight: 800;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .prose-content :global(h3) {
    margin-top: 1.5em;
    margin-bottom: 0.5em;
    font-size: 1.125rem;
    font-weight: 800;
  }
  .prose-content :global(a) {
    color: var(--color-research);
    text-decoration: underline;
  }
  .prose-content :global(ul),
  .prose-content :global(ol) {
    margin-bottom: 1.25em;
    padding-left: 1.5em;
  }
  .prose-content :global(ul) {
    list-style: disc;
  }
  .prose-content :global(ol) {
    list-style: decimal;
  }
  .prose-content :global(li) {
    margin-bottom: 0.375em;
  }
  .prose-content :global(code) {
    background-color: var(--color-paper-raised);
    padding: 0.15em 0.4em;
    font-family: var(--font-mono);
    font-size: 0.875em;
  }
  .prose-content :global(pre) {
    margin-bottom: 1.25em;
    overflow-x: auto;
    background-color: var(--color-paper-raised);
    padding: 1em;
  }
  .prose-content :global(pre code) {
    background: none;
    padding: 0;
  }
  .prose-content :global(blockquote) {
    border-left: 2px solid var(--color-research);
    padding-left: 1em;
    color: var(--color-ink-muted);
    font-style: italic;
  }

  /*
   * Article-only reading polish (T-23): a Medium-style drop cap on the
   * opening paragraph and a centered pull-quote treatment. The measure
   * itself no longer needs a special-cased max-width here — every post's
   * .post-main column is already 680px (--container-prose) via the grid
   * above, article or not, since T-57 moved the whole page onto that grid.
   */
  .prose-article :global(p:first-of-type::first-letter) {
    float: left;
    margin-top: 0.03em;
    margin-right: 0.09em;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 3.4em;
    line-height: 0.8;
    color: var(--color-research);
  }
  .prose-article :global(blockquote) {
    margin: 2em 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    border-left: none;
    padding: 1.5em 0;
    text-align: center;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-style: italic;
    line-height: 1.4;
  }
</style>
