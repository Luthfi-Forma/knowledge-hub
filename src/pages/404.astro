---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Afreza Hernanda">
  <section class="mx-auto max-w-(--container-shell) px-5 py-16 text-center">
    <p class="mb-2.5 text-xs font-medium tracking-wide text-research uppercase">404</p>
    <h1 class="font-display mb-3.5 text-3xl font-extrabold text-ink sm:text-4xl">Page not found</h1>
    <p class="mx-auto mb-6 max-w-[38ch] text-sm leading-relaxed text-ink-muted">
      The page you're looking for doesn't exist or has moved.
    </p>
    <a
      href="/"
      class="inline-flex min-h-11 items-center bg-ink px-5 text-sm font-semibold text-paper hover:bg-ink-muted focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-research"
    >
      Back to home
    </a>
  </section>
</BaseLayout>
