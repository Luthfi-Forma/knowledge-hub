---
// /explore/[type] — "sama dengan index terfilter" (docs/design/atlas/
// README.md IA table): the same Sheet Index composition as `/`, just
// pre-filtered to one type. Reuses SheetIndex.astro directly (T-55)
// rather than a separate grid+TypeFilter markup (T-50's interim version,
// built before SheetIndex existed) — LegendRail's own type-legend block
// already gives this page filter navigation with an active state, so a
// second, separate TypeFilter control would just duplicate it.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SheetIndex from '../../components/index/SheetIndex.astro';
import { getPublishedPosts, POST_TYPES, TYPE_LABEL } from '../../lib/posts';
import { topicCounts } from '../../lib/topics';

export function getStaticPaths() {
  return POST_TYPES.map((type) => ({ params: { type } }));
}

const { type } = Astro.params as { type: (typeof POST_TYPES)[number] };
const posts = await getPublishedPosts();
const topicCount = topicCounts(posts).size;
const breadcrumbLeft = `Sheet index · ${posts.length} plates · ${topicCount} topics · filter: ${type}`;
---

<BaseLayout title={`${TYPE_LABEL[type]} — Afreza Hernanda`} breadcrumbLeft={breadcrumbLeft}>
  <SheetIndex posts={posts} activeType={type} />
</BaseLayout>
