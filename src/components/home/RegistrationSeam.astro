---
// Registration seam (M5/T-42) — a draggable alternative to the header's
// plain toggle button, scoped to the homepage because that's currently the
// only page with two genuinely different compositions to reveal (T-40's
// DATUM index vs. the Reading Mode homepage). Grafted from the "Ground
// Truth" direction in the M5 brainstorm, no-clone version only: this drags
// the SAME two `[data-mode-view]` trees T-40 already built — nothing here
// duplicates DOM, and nothing here is a framework island (Tier-1 vanilla,
// ADR-002 clause 2 / ADR-003 clause 2).
//
// Mechanism: at rest, the existing global [data-mode-view] display:none/
// block rule governs (normal document flow, one tree hidden). While
// dragging (`data-seam-dragging` on the stage), both trees are stacked via
// CSS Grid into the same box and the immersive one is clipped with
// `clip-path: inset(0 calc(100% - var(--seam)) 0 0)` — revealing more of
// it from the left as the grip moves right. On release it snaps to
// whichever side has the majority and commits the real mode change via
// src/lib/mode-toggle.ts, then hands control back to the resting-state
// display:none/block rule.
---

<div class="seam-stage" data-seam-stage>
  <div class="seam-layer" data-mode-view="reading">
    <slot name="reading" />
  </div>
  <div class="seam-layer" data-mode-view="immersive" data-pagefind-ignore>
    <slot name="immersive" />
  </div>
  <div
    class="seam-grip"
    data-seam-grip
    role="slider"
    tabindex="0"
    aria-label="Reveal Immersive Mode"
    aria-orientation="horizontal"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
  >
    <span class="seam-grip-line" aria-hidden="true"></span>
    <span class="seam-grip-handle" aria-hidden="true"></span>
  </div>
</div>

<style>
  .seam-stage {
    position: relative;
  }

  /*
   * Registered so the browser can smoothly interpolate --seam when it
   * jumps from a live drag value to the settled 0%/100%, purely in CSS —
   * no rAF, matching the "tanpa rAF" requirement (pointer events are
   * already frame-coalesced, and the settle animation below needs no JS
   * timing loop of its own).
   */
  @property --seam {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 0%;
  }

  /*
   * Sets the grip's resting position from CSS, not only from the script's
   * setSeam() call on load. Two independent reasons: (1) avoids a real,
   * if brief, flash in any browser — without this the grip briefly renders
   * at its 0% default before JS runs, then jumps; (2) this tool's browser
   * has a confirmed gap (see docs/memory/LESSONS.md, T-39) where an
   * already-painted element's clamp()/calc() involving a custom property
   * doesn't visibly update after the property is changed via JS on that
   * same element post-paint, even though a genuine page load with the
   * value already correct (like this rule) renders right the first time —
   * same root cause as the body-background finding, different property.
   */
  :root[data-mode='immersive'] .seam-stage {
    --seam: 100%;
  }

  /* Dragging state only: stack both trees in the same grid cell and let
     clip-path do the reveal. Needs !important — same reasoning as the
     reduced-motion net in global.css: this must unconditionally win over
     the global [data-mode-view] display:none/block rule regardless of
     cascade-layer position, because it's a temporary override of it. */
  .seam-stage[data-seam-dragging] {
    display: grid;
  }
  .seam-stage[data-seam-dragging] .seam-layer {
    grid-area: 1 / 1;
    display: block !important;
    transition: clip-path 220ms ease;
  }
  .seam-stage[data-seam-dragging] .seam-layer[data-mode-view='immersive'] {
    clip-path: inset(0 calc(100% - var(--seam)) 0 0);
  }

  /*
   * Always rendered and focusable — NOT display:none until a drag starts.
   * An earlier version hid this at rest, which meant a keyboard user could
   * never Tab to it to begin a drag in the first place (you can't focus a
   * hidden, tabindex="0" role="slider" element per spec — display:none
   * removes it from the tab order entirely). Found via testing, not
   * hypothetical: `.focus()` on it silently failed at rest. It sits at the
   * edge matching the current mode when not dragging, and tracks live
   * during one — the header toggle (T-39) remains the simpler, always-
   * obvious way to switch modes; this is a richer pointer-first
   * alternative that must still be independently keyboard-operable.
   */
  .seam-grip {
    position: absolute;
    top: 1.5rem;
    /* Clamped, not a raw percentage: at rest (--seam: 0% or 100%) a plain
       `left: var(--seam)` centers the handle exactly on the stage edge,
       leaving half of it cut off past the viewport — confirmed via testing
       at 375px. The clamp keeps it fully on-screen at both extremes while
       still tracking --seam accurately everywhere in between. */
    left: clamp(1.375rem, var(--seam), calc(100% - 1.375rem));
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    cursor: ew-resize;
    touch-action: none;
    transition: left 220ms ease;
  }
  /* The full-height guide line is decorative and only meaningful mid-drag
     — a stray vertical line down the resting page would look like a bug. */
  .seam-grip-line {
    position: absolute;
    top: -1.5rem;
    bottom: -1.5rem;
    left: 50%;
    width: 1px;
    background-color: var(--color-accent);
    opacity: 0;
    pointer-events: none;
  }
  .seam-stage[data-seam-dragging] .seam-grip-line {
    opacity: 1;
  }
  .seam-grip-handle {
    display: flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    background-color: var(--color-paper);
    color: var(--color-accent);
    pointer-events: none;
  }
  .seam-grip-handle::before {
    content: '↔';
    font-size: 1rem;
  }
  .seam-grip:focus-visible .seam-grip-handle {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .seam-stage[data-seam-dragging] .seam-layer,
    .seam-grip {
      transition: none;
    }
  }
</style>

<script>
  import { getMode, setMode, type Mode } from '../../lib/mode-toggle';

  const stage = document.querySelector<HTMLElement>('[data-seam-stage]');
  const grip = document.querySelector<HTMLElement>('[data-seam-grip]');
  if (stage && grip) {
    let dragging = false;
    const SETTLE_MS = 220;

    function setSeam(pct: number) {
      const clamped = Math.min(100, Math.max(0, pct));
      stage!.style.setProperty('--seam', `${clamped}%`);
      grip!.setAttribute('aria-valuenow', String(Math.round(clamped)));
    }

    function seamFromMode(mode: Mode) {
      return mode === 'immersive' ? 100 : 0;
    }

    function pctFromClientX(clientX: number): number {
      const rect = stage!.getBoundingClientRect();
      return ((clientX - rect.left) / rect.width) * 100;
    }

    function settle(pct: number) {
      const mode: Mode = pct >= 50 ? 'immersive' : 'reading';
      setSeam(seamFromMode(mode));
      setMode(mode);
      window.setTimeout(() => {
        stage!.removeAttribute('data-seam-dragging');
      }, SETTLE_MS);
    }

    grip.addEventListener('pointerdown', (e) => {
      dragging = true;
      grip!.setPointerCapture(e.pointerId);
      stage!.setAttribute('data-seam-dragging', '');
      setSeam(pctFromClientX(e.clientX));
    });
    grip.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      setSeam(pctFromClientX(e.clientX));
    });
    grip.addEventListener('pointerup', (e) => {
      if (!dragging) return;
      dragging = false;
      const pct = pctFromClientX(e.clientX);
      settle(pct);
    });
    grip.addEventListener('pointercancel', () => {
      dragging = false;
      settle(seamFromMode(getMode()));
    });

    grip.addEventListener('keydown', (e) => {
      const current = parseFloat(getComputedStyle(stage!).getPropertyValue('--seam')) || seamFromMode(getMode());
      let next: number | null = null;
      if (e.key === 'ArrowRight') next = current + 10;
      else if (e.key === 'ArrowLeft') next = current - 10;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = 100;
      if (next === null) return;
      e.preventDefault();
      stage!.setAttribute('data-seam-dragging', '');
      settle(next);
    });

    // Stay in sync when the mode changes from elsewhere (the header
    // toggle) without a full page reload.
    document.addEventListener('kh-mode-change', () => {
      if (!dragging) setSeam(seamFromMode(getMode()));
    });

    setSeam(seamFromMode(getMode()));
  }
</script>
