---
// DATUM index (M5/T-40) — no longer imported anywhere since T-47 removed
// the dual-mode mechanism that used to switch between it and the Reading
// Mode homepage (ADR-004). Kept as-is, unused, for M6/T-55 to promote into
// `components/index/SheetIndex.astro`; colors below are `var(--color-*)`
// references only, so it inherits Atlas's token overhaul (T-48) untouched.
import type { CollectionEntry } from 'astro:content';
import { POST_TYPES } from '../../lib/posts';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;

const TYPE_LABEL: Record<(typeof POST_TYPES)[number], string> = {
  project: 'Project',
  research: 'Research',
  article: 'Article',
  photo: 'Photo',
};

// Placement is derived from `type` (column) + `date` (row order within the
// column) — never hand-authored per post. Adding post #12 changes nothing
// here; it just becomes another row in its column.
const columns = POST_TYPES.map((type) => ({
  type,
  label: TYPE_LABEL[type],
  plates: posts
    .filter((post) => post.data.type === type)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
}));

const compiledYear = new Date().getFullYear();
---

<section class="datum-index" aria-label="Post index, immersive presentation">
  <div class="datum-collar-top">
    <span>Afreza L. Hernanda — Knowledge Series</span>
    <span>{posts.length} sheets</span>
  </div>

  <div class="datum-field">
    <div class="datum-columns">
      {
        columns.map((column) => (
          <div class="datum-column">
            <a href={`/explore/${column.type}`} class="datum-column-header">
              <span class={`datum-swatch datum-hatch-${column.type}`} aria-hidden="true" />
              <span>{column.label}</span>
              <span class="datum-column-count">{column.plates.length}</span>
            </a>
            <div class="datum-plates">
              {column.plates.length === 0 ? (
                <p class="datum-empty">—</p>
              ) : (
                column.plates.map((post, i) => (
                  <a href={`/posts/${post.id}`} class={`datum-plate datum-hatch-${column.type}`}>
                    <span class="datum-plate-top">
                      <span class="datum-plate-number">{String(i + 1).padStart(2, '0')}</span>
                      <span class="datum-plate-year">{post.data.date.getFullYear()}</span>
                    </span>
                    <span class="datum-plate-title">{post.data.title}</span>
                    {post.data.coordinates && <span class="datum-plate-coord">{post.data.coordinates}</span>}
                  </a>
                ))
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="datum-collar-bottom">
    <span>Projection Web Mercator · Datum WGS84</span>
    <span>Compiled {compiledYear}</span>
  </div>
</section>

<style>
  .datum-index {
    border: 1px solid var(--color-line);
    color: var(--color-ink);
  }

  .datum-collar-top,
  .datum-collar-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.75rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .datum-collar-top {
    border-bottom: 1px solid var(--color-line);
  }
  .datum-collar-bottom {
    border-top: 1px solid var(--color-line);
  }

  /* CSS-only graticule field — no image asset, no canvas. A low-opacity
     hairline grid sits behind the columns via ::before so it never dims
     the actual content painted on top of it. */
  .datum-field {
    position: relative;
    padding: 1px 0 0 1px;
  }
  .datum-field::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.5;
    background-image:
      repeating-linear-gradient(to right, var(--color-line) 0 1px, transparent 1px 48px),
      repeating-linear-gradient(to bottom, var(--color-line) 0 1px, transparent 1px 48px);
  }

  .datum-columns {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .datum-column {
    border-left: 1px solid var(--color-line);
  }
  .datum-column:first-child {
    border-left: none;
  }

  .datum-column-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--color-line);
    background-color: var(--color-paper-raised);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    text-decoration: none;
    transition:
      color 200ms ease,
      background-color 200ms ease;
  }
  .datum-column-header:hover,
  .datum-column-header:focus-visible {
    color: var(--color-research);
    background-color: var(--color-paper);
  }
  .datum-column-count {
    margin-left: auto;
    font-family: var(--font-mono);
    color: var(--color-ink-muted);
  }

  .datum-swatch {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
    border: 1px solid var(--color-line);
  }

  .datum-plates {
    display: flex;
    flex-direction: column;
    padding: 0.5rem;
    gap: 0.5rem;
  }
  .datum-empty {
    padding: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }

  .datum-plate {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--color-line);
    background-color: var(--color-paper-raised);
    color: var(--color-ink);
    text-decoration: none;
    overflow: hidden;
    transition:
      border-color 200ms ease,
      background-color 200ms ease;
  }
  .datum-plate::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.1;
    pointer-events: none;
  }
  .datum-plate:hover,
  .datum-plate:focus-visible {
    border-color: var(--color-research);
    background-color: var(--color-paper);
  }
  .datum-plate > * {
    position: relative;
    z-index: 1;
  }

  .datum-plate-top {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--color-ink-muted);
  }
  .datum-plate-title {
    font-size: 0.8125rem;
    line-height: 1.35;
  }
  .datum-plate-coord {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-muted);
  }

  /* Land-class hatch per post type — reuses the existing remapped tokens
     (no new custom properties). Swatch renders the pattern at legend size;
     the same class on a plate drives its low-opacity ::before overlay. */
  .datum-swatch.datum-hatch-project,
  .datum-plate.datum-hatch-project::before {
    background-image: repeating-linear-gradient(45deg, var(--color-chart-2) 0 2px, transparent 2px 7px);
  }
  .datum-swatch.datum-hatch-research,
  .datum-plate.datum-hatch-research::before {
    background-image:
      repeating-linear-gradient(45deg, var(--color-research) 0 2px, transparent 2px 7px),
      repeating-linear-gradient(-45deg, var(--color-research) 0 2px, transparent 2px 7px);
  }
  .datum-swatch.datum-hatch-article,
  .datum-plate.datum-hatch-article::before {
    background-image: radial-gradient(var(--color-ink-muted) 1px, transparent 1.5px);
    background-size: 7px 7px;
  }
  .datum-swatch.datum-hatch-photo,
  .datum-plate.datum-hatch-photo::before {
    background-image: radial-gradient(var(--color-line) 1.5px, transparent 2px);
    background-size: 6px 6px;
  }

  @media (max-width: 40rem) {
    .datum-columns {
      grid-template-columns: repeat(2, 1fr);
    }
    .datum-column:nth-child(3) {
      border-left: none;
    }
  }
  @media (max-width: 26rem) {
    .datum-columns {
      grid-template-columns: 1fr;
    }
    .datum-column {
      border-left: none;
      border-top: 1px solid var(--color-line);
    }
    .datum-column:first-child {
      border-top: none;
    }
  }
</style>
