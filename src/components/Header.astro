---
const navItems = [
  { href: '/explore', label: 'Explore' },
  { href: '/photography', label: 'Photography' },
  { href: '/about', label: 'About' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-10 border-b border-line bg-paper">
  <div class="mx-auto flex max-w-(--container-content) flex-wrap items-center justify-between gap-x-3 gap-y-1 px-5 py-4">
    <a href="/" class="font-display text-base text-ink sm:text-lg">Afreza Hernanda</a>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <nav aria-label="Primary" class="flex flex-wrap gap-x-0.5 text-xs font-medium tracking-wide text-ink-muted uppercase">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="inline-flex min-h-11 items-center px-1.5 text-ink-muted hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:px-2"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <button
        type="button"
        id="mode-toggle"
        aria-pressed="false"
        class="inline-flex min-h-11 items-center border border-line px-2.5 text-xs font-medium tracking-wide text-ink-muted uppercase hover:border-accent hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        <span data-mode-label>Immersive</span>
      </button>
    </div>
  </div>
</header>

<script>
  // Tier-1 vanilla (ADR-002 clause 2 / ADR-003 clause 2) — no framework,
  // no client:* directive. Mode logic itself lives in src/lib/mode-toggle.ts,
  // shared with the registration seam (T-42) so the two controls can't
  // drift out of sync.
  import { getMode, setMode } from '../lib/mode-toggle';

  const toggle = document.getElementById('mode-toggle');
  const label = toggle?.querySelector('[data-mode-label]');

  function syncUI() {
    const mode = getMode();
    toggle?.setAttribute('aria-pressed', String(mode === 'immersive'));
    if (label) label.textContent = mode === 'immersive' ? 'Reading' : 'Immersive';
  }

  toggle?.addEventListener('click', () => {
    setMode(getMode() === 'immersive' ? 'reading' : 'immersive');
  });
  // Stay in sync if the mode changes from elsewhere (e.g. the homepage's
  // registration seam) without a full page reload.
  document.addEventListener('kh-mode-change', syncUI);

  syncUI();
</script>
