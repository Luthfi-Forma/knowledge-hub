---
// Collar — Atlas's two-row header (M6/T-52). Spec:
// docs/design/atlas/README.md "Header — collar lembar (dua baris)"; layout
// reference docs/design/atlas/Hi-Fi - Atlas Screens.dc.html (every screen's
// top chrome). Row 1: wordmark + 4-item nav + search control. Row 2:
// breadcrumb in "sheet notation" (mono, uppercase, ink-muted on
// paper-raised) — replaces a conventional breadcrumb, and is deliberately
// per-page content, not decoration (Hi-Fi shows different text on every
// one of the 5 screens, e.g. "Sheet index · 11 plates · 20 topics · no
// filter" on `/` vs "Index / Research / Plate 01" on a post).
//
// Nav is the IA's final 4 items (Index/Topics/Projects/About) — Explore,
// Photography, and Contact drop out per ADR-004/the handoff's IA table:
// Photography becomes secondary (reachable via Footer's type index),
// Contact becomes a real block on /about + the footer, not a nav item.
// "Topics" now points at /topics (T-54 renamed the route + added the
// /tags → /topics redirect in vercel.json).
//
// Search dialog (M6/T-60): opened by the button below or the `/` shortcut
// (guarded against typing targets, same pattern as the scrollytelling
// shell's PageUp/PageDown handler), closed by Escape, backdrop click, or
// the dialog's own close button. Pagefind's classic widget
// (`pagefind-ui.js`/`.css`) is only injected on first open, not on every
// page load — it only exists in `dist/pagefind/` after a real build
// (`pagefind --site dist`), so there's nothing to fetch until a visitor
// actually opens search. Token overrides live in global.css
// (`--pagefind-ui-*`), not here — this component only owns open/close.
const pathname = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));

const navItems = [
  { href: '/', label: 'Index' },
  { href: '/topics', label: 'Topics' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
];

interface Props {
  /** Left side of the row-2 breadcrumb — page-specific ("Sheet index · 11 plates · ...", "Index / Research / Plate 01"). Falls back to the page title when a page hasn't been given precise breadcrumb text yet (T-55–T-58 each supply their own). */
  breadcrumbLeft: string;
  /** Right side of row 2 — also page-specific in the handoff (a post's coordinates+date, a topic's neighbour-count note), not always the "Projection..." constant. Defaults to that constant since most pages have no more specific fact to show yet. */
  breadcrumbRight?: string;
}

const { breadcrumbLeft, breadcrumbRight } = Astro.props;
const compiledYear = new Date().getFullYear();
const resolvedBreadcrumbRight = breadcrumbRight ?? `Projection Web Mercator · Datum WGS84 · Compiled ${compiledYear}`;
---

<header class="collar">
  <div class="collar-row-1">
    <a href="/" class="wordmark">Afreza L. Hernanda</a>
    <nav aria-label="Primary" class="collar-nav">
      {
        navItems.map((item) => (
          <a href={item.href} class:list={['nav-link', isActive(item.href) && 'is-active']} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <button
      type="button"
      id="search-trigger"
      class="header-search"
      aria-haspopup="dialog"
      aria-controls="search-dialog"
      aria-expanded="false"
      aria-label="Search"
    >
      <span aria-hidden="true">⌕</span> Search <span class="header-search-kbd" aria-hidden="true">/</span>
    </button>
  </div>
  <div class="collar-row-2">
    <span class="breadcrumb-left">{breadcrumbLeft}</span>
    <span class="breadcrumb-right">{resolvedBreadcrumbRight}</span>
  </div>
</header>

<div class="search-backdrop" data-search-backdrop hidden></div>
<div id="search-dialog" class="search-dialog" role="dialog" aria-modal="true" aria-label="Search" hidden>
  <div class="search-dialog-panel">
    <div class="search-dialog-head">
      <span class="search-dialog-label">Search</span>
      <button type="button" class="control control-icon" data-search-close aria-label="Close search">✕</button>
    </div>
    <div id="pagefind-search"></div>
  </div>
</div>

<script>
  const trigger = document.getElementById('search-trigger');
  const dialog = document.getElementById('search-dialog');
  const backdrop = document.querySelector<HTMLElement>('[data-search-backdrop]');
  const closeBtn = document.querySelector<HTMLElement>('[data-search-close]');
  const mount = document.getElementById('pagefind-search');
  let pagefindLoaded = false;

  function isTypingTarget(el: EventTarget | null) {
    if (!(el instanceof HTMLElement)) return false;
    return el.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(el.tagName);
  }

  function loadPagefindUI(onReady: () => void) {
    if (pagefindLoaded) {
      onReady();
      return;
    }
    pagefindLoaded = true;
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = '/pagefind/pagefind-ui.css';
    document.head.appendChild(link);
    const script = document.createElement('script');
    script.src = '/pagefind/pagefind-ui.js';
    script.onload = () => {
      // @ts-expect-error — global from pagefind-ui.js's classic (non-module) bundle, present only after `pagefind --site dist` has run
      new window.PagefindUI({ element: '#pagefind-search', showSubResults: true, showImages: false });
      onReady();
    };
    script.onerror = () => {
      if (mount) mount.textContent = 'Search index only available in production builds (astro preview / the deployed site).';
      onReady();
    };
    document.body.appendChild(script);
  }

  function openDialog() {
    dialog?.removeAttribute('hidden');
    if (backdrop) backdrop.hidden = false;
    trigger?.setAttribute('aria-expanded', 'true');
    loadPagefindUI(() => {
      dialog?.querySelector<HTMLElement>('input')?.focus();
    });
  }

  function closeDialog() {
    dialog?.setAttribute('hidden', '');
    if (backdrop) backdrop.hidden = true;
    trigger?.setAttribute('aria-expanded', 'false');
    trigger?.focus();
  }

  trigger?.addEventListener('click', openDialog);
  backdrop?.addEventListener('click', closeDialog);
  closeBtn?.addEventListener('click', closeDialog);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && dialog && !dialog.hidden) {
      closeDialog();
      return;
    }
    if (e.key === '/' && dialog?.hidden && !isTypingTarget(e.target) && !e.metaKey && !e.ctrlKey && !e.altKey) {
      e.preventDefault();
      openDialog();
    }
  });
</script>

<style>
  .collar {
    position: sticky;
    top: 0;
    z-index: 20;
    background-color: var(--color-paper);
  }

  .collar-row-1 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    padding: 16px 48px;
    border-bottom: 1px solid var(--color-ink);
  }

  .wordmark {
    font-family: var(--font-display);
    font-stretch: 118%;
    font-weight: 700;
    font-size: 18px;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }

  /* nav + search sit as two more flex items in .collar-row-1 (not nested
     in a wrapper anymore, T-68) — margin-left: auto on nav pushes nav AND
     everything after it (search) to the right edge as a unit, the same
     visual grouping the old wordmark/[nav+search] justify-content:
     space-between gave, but as siblings so <640px can reorder them
     independently (see the media query below) instead of nav being stuck
     wrapping inside its old parent. */
  .collar-nav {
    display: flex;
    flex-wrap: wrap;
    margin-left: auto;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-ink-muted);
    border-bottom: 2px solid transparent;
    transition:
      color 120ms ease,
      border-color 120ms ease;
    white-space: nowrap;
  }
  .nav-link:hover {
    color: var(--color-ink);
  }
  .nav-link:focus-visible {
    outline: 2px solid var(--color-research);
    outline-offset: 2px;
  }
  .nav-link.is-active {
    color: var(--color-ink);
    border-bottom-color: var(--color-research);
  }

  .header-search {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--color-line-strong);
    background: none;
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    white-space: nowrap;
  }
  .header-search:hover {
    border-color: var(--color-research);
    color: var(--color-research);
  }
  .header-search:focus-visible {
    outline: 2px solid var(--color-research);
    outline-offset: 2px;
  }

  .header-search-kbd {
    border: 1px solid var(--color-line);
    padding: 0 4px;
    font-size: 10.5px;
  }

  .collar-row-2 {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 20px;
    padding: 8px 48px;
    border-bottom: 1px solid var(--color-ink);
    background-color: var(--color-paper-raised);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  /* <640px collar (T-68): the 48px/16px horizontal padding above is sized
     for desktop and was unconditional — at 375px it alone left only
     ~279px for wordmark + 4 nav links + search, forcing 3 lines of wrap
     and a measured 305px-tall header (38% of a 375x812 screen) before any
     page content appeared. Fixed by re-flowing row 1 into two lines via
     `order` (wordmark + search together, nav on its own full-width
     scrollable line — nav stays all 4 real links, not a hamburger, which
     would be a new IA decision this task isn't making) and trimming row
     2 to its left half only (the right half is decorative sheet notation,
     "Projection Web Mercator · Datum WGS84 · Compiled {year}" or a page's
     own equivalent — not navigation, safe to drop when space is tight).
     Measured after: ~144px total, comfortably under the ≤160px target. */
  @media (max-width: 639px) {
    .collar-row-1 {
      justify-content: space-between;
      padding: 10px 16px;
      gap: 8px 12px;
    }
    .wordmark {
      order: 1;
    }
    .header-search {
      order: 2;
    }
    .collar-nav {
      order: 3;
      flex-basis: 100%;
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-left: 0;
    }
    .collar-row-2 {
      flex-wrap: nowrap;
      padding: 6px 16px;
    }
    .breadcrumb-right {
      display: none;
    }
    .breadcrumb-left {
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
  }

  .search-backdrop {
    position: fixed;
    inset: 0;
    z-index: 50;
    background-color: rgb(23 21 18 / 40%);
  }
  .search-backdrop[hidden] {
    display: none;
  }

  .search-dialog {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    justify-content: center;
    padding: 72px 20px 20px;
  }
  .search-dialog[hidden] {
    display: none;
  }

  .search-dialog-panel {
    width: 100%;
    max-width: 640px;
    max-height: calc(100vh - 92px);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-ink);
    background-color: var(--color-paper);
  }

  .search-dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--color-line-strong);
  }

  .search-dialog-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  #pagefind-search {
    padding: 16px;
    overflow-y: auto;
  }
</style>
