---
// The Sources slide-over (M10/T-75, ADR-005) — trigger, backdrop, and panel.
//
// Was React inside the scrollytelling island; it holds one boolean and closes
// on a click, so it is Tier-1 vanilla here (ADR-003 #1/#2). Note this is a
// leaf page component, not a global layout, so ADR-002 clause 4 does not
// apply — and unlike the old version it costs nothing on pages that never
// open it.
//
// Modelled on LegendRail.astro's drawer, deliberately: that pattern already
// handles Escape, backdrop click, focus into the panel on open, and focus
// back to the trigger on close. The React panel it replaces had a Close
// button and a backdrop and nothing else — no Escape, no focus management.
//
// Citations come from the post's `story.scenes` frontmatter rather than from
// each scene, because this is the one place they are shown as a set. Scenes
// are identified by number only: their titles live in the MDX body, which
// nothing outside it can read (see src/content.config.ts). The §NN here lines
// up with the counter rendered beside each scene's kicker.
interface Citation {
  label: string;
  where: string;
  quote?: string;
}

interface Props {
  source: { label: string; author: string; work: string; note: string };
  scenes: { id: string; citations: Citation[]; vizCitation?: { fig: string; source: string } }[];
}

const { source, scenes } = Astro.props;
const cited = scenes.filter((s) => s.citations.length > 0 || s.vizCitation);
---

<button
  type="button"
  id="story-sources-trigger"
  class="control control-secondary story-sources-trigger"
  aria-expanded="false"
  aria-controls="story-sources-panel"
>
  Sources
</button>

<div class="story-sources-backdrop" data-story-sources-backdrop hidden></div>

<aside
  id="story-sources-panel"
  class="story-sources-panel"
  aria-label="Sources for this story"
  hidden
>
  <div class="story-sources-head">
    <div>
      <p class="story-sources-kicker">Sources</p>
      <p class="story-sources-heading">Where every claim comes from</p>
    </div>
    <button type="button" class="control control-secondary" data-story-sources-close>Close</button>
  </div>

  <div class="story-sources-body">
    <div class="story-sources-work">
      <p class="story-sources-kicker">{source.label}</p>
      <p class="story-sources-author">{source.author}</p>
      <p class="story-sources-title">{source.work}</p>
      <p class="story-sources-note">{source.note}</p>
    </div>

    <ol class="story-sources-list">
      {
        cited.map((scene) => {
          // Number against the FULL scene list, so §03 here is the scene
          // showing 03 in the reading column even when earlier scenes cite
          // nothing and are skipped from this list.
          const n = String(scenes.findIndex((s) => s.id === scene.id) + 1).padStart(2, '0');
          return (
            <li class="story-sources-item">
              <p class="story-sources-num">§{n}</p>
              {scene.vizCitation && (
                <div class="story-sources-sub">
                  <p class="story-sources-sublabel">Visualization</p>
                  <p class="story-sources-fig">
                    {scene.vizCitation.fig} <span>— {scene.vizCitation.source}</span>
                  </p>
                </div>
              )}
              {scene.citations.length > 0 && (
                <div class="story-sources-sub">
                  <p class="story-sources-sublabel">Text citations</p>
                  <ul class="story-sources-cites">
                    {scene.citations.map((c) => (
                      <li>
                        <span class="story-sources-cite-label">{c.label}</span>
                        <span class="story-sources-cite-where">· {c.where}</span>
                        {c.quote && <p class="story-sources-quote">“{c.quote}”</p>}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          );
        })
      }
    </ol>
  </div>
</aside>

<script>
  const trigger = document.getElementById('story-sources-trigger');
  const panel = document.getElementById('story-sources-panel');
  const backdrop = document.querySelector<HTMLElement>('[data-story-sources-backdrop]');
  const closeBtn = document.querySelector<HTMLElement>('[data-story-sources-close]');

  function openPanel() {
    panel?.removeAttribute('hidden');
    if (backdrop) backdrop.hidden = false;
    trigger?.setAttribute('aria-expanded', 'true');
    closeBtn?.focus();
  }

  function closePanel() {
    panel?.setAttribute('hidden', '');
    if (backdrop) backdrop.hidden = true;
    trigger?.setAttribute('aria-expanded', 'false');
    trigger?.focus();
  }

  trigger?.addEventListener('click', () => {
    panel?.hasAttribute('hidden') ? openPanel() : closePanel();
  });
  closeBtn?.addEventListener('click', closePanel);
  backdrop?.addEventListener('click', closePanel);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel?.hasAttribute('hidden')) closePanel();
  });
</script>

<style>
  .story-sources-trigger {
    /* .control sets min-height 44px; the hero's meta row is a 12px mono line,
       so let this sit tighter than a standalone control would. */
    min-height: 36px;
    padding: 0 14px;
  }

  /*
   * Same fade-not-pop treatment T-72 gave LegendRail's backdrop: `display`
   * overrides the UA's `[hidden] { display: none }` so the element stays in
   * the box tree long enough to animate, and `visibility` is what removes it
   * from hit-testing once the fade ends.
   */
  .story-sources-backdrop {
    position: fixed;
    inset: 0;
    z-index: 40;
    background-color: rgb(23 21 18 / 40%);
    opacity: 1;
    transition:
      opacity 200ms var(--ease-out),
      visibility 200ms var(--ease-out);
  }
  .story-sources-backdrop[hidden] {
    display: block;
    opacity: 0;
    visibility: hidden;
  }

  .story-sources-panel {
    position: fixed;
    inset-block: 0;
    right: 0;
    z-index: 50;
    display: flex;
    width: 100%;
    max-width: 28rem;
    flex-direction: column;
    border-left: 1px solid var(--color-line);
    background-color: var(--color-paper);
    text-align: left;
    /* --ease-in-out: travels across the screen while staying present, same
       reasoning as the LegendRail drawer (T-72). */
    transition: transform 200ms var(--ease-in-out);
  }
  .story-sources-panel[hidden] {
    display: flex;
    transform: translateX(100%);
    visibility: hidden;
  }

  .story-sources-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid var(--color-line);
    padding: 16px 24px;
  }

  .story-sources-kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-research);
  }

  .story-sources-heading {
    margin: 4px 0 0;
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--color-ink);
  }

  .story-sources-body {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
  }

  .story-sources-work {
    margin-bottom: 24px;
    border: 1px solid var(--color-line);
    background-color: var(--color-paper-raised);
    padding: 16px;
    font-size: var(--text-meta);
    color: var(--color-ink-muted);
  }
  .story-sources-author {
    margin: 8px 0 0;
    color: var(--color-ink);
  }
  .story-sources-title {
    margin: 0;
    font-style: italic;
  }
  .story-sources-note {
    margin: 4px 0 0;
    font-size: 12px;
  }

  .story-sources-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .story-sources-item {
    border: 1px solid var(--color-line);
    background-color: var(--color-paper-raised);
    padding: 16px;
  }

  .story-sources-num {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-research);
  }

  .story-sources-sub {
    margin-top: 12px;
  }

  .story-sources-sublabel {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .story-sources-fig {
    margin: 4px 0 0;
    font-size: 12px;
    color: var(--color-ink);
  }
  .story-sources-fig span {
    color: var(--color-ink-muted);
  }

  .story-sources-cites {
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 12px;
  }
  .story-sources-cites > li {
    border-left: 2px solid var(--color-research);
    padding-left: 12px;
  }
  .story-sources-cite-label {
    color: var(--color-ink);
  }
  .story-sources-cite-where {
    color: var(--color-ink-muted);
  }
  .story-sources-quote {
    margin: 2px 0 0;
    font-style: italic;
    color: var(--color-ink-muted);
  }
</style>
